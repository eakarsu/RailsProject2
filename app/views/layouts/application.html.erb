<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= content_for?(:title) ? yield(:title) : "RailsProject2" %></title>
  <meta name="description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : "Independent articles from RailsProject2" %>">
  <% if content_for?(:canonical_url) %><link rel="canonical" href="<%= yield(:canonical_url) %>"><% end %>
  <%= stylesheet_link_tag "application", media: "all" %>
  <%= csrf_meta_tags %>
<style>
.codex-rails-shell{display:grid;grid-template-columns:240px minmax(0,1fr);gap:20px;max-width:1500px;margin:0 auto;padding:16px}.codex-rails-main{min-width:0}
.codex-rails-sidebar{position:sticky;top:16px;align-self:start;height:calc(100vh - 32px);overflow:auto;padding:18px 12px;border-radius:12px;background:#0b1220;color:#f8fafc;border:1px solid #26364d}
.codex-rails-sidebar strong{display:block;font-size:16px;line-height:1.3;padding:8px 10px 16px;border-bottom:1px solid #334155}.codex-rails-sidebar nav{display:flex!important;flex-direction:column!important;align-items:stretch!important;gap:2px!important;padding-top:12px}
.codex-rails-sidebar nav a{display:block!important;color:#cbd5e1!important;text-decoration:none!important;padding:9px 11px!important;border-radius:8px;font-size:13px;font-weight:600;line-height:1.3}.codex-rails-sidebar nav a:hover,.codex-rails-sidebar nav a:focus-visible{background:#1e293b;color:#fff!important}
@media(max-width:800px){.codex-rails-shell{grid-template-columns:minmax(0,1fr)}.codex-rails-sidebar{position:relative;height:auto;max-height:280px}}
</style>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="site-header">
    <nav aria-label="Primary navigation"><a href="/ai-workspace">AI workspace</a>
      <%= link_to "RailsProject2", root_path, class: "brand" %>
      <%= link_to "Search", search_path %>
      <%= link_to "RSS", feed_path(format: :rss) %>
      <% if signed_in? %>
        <%= link_to "My articles", posts_path(mine: 1) %>
        <%= link_to "New draft", new_post_path %>
        <% if current_user.editor? %><%= link_to "Editorial queue", editorial_path %><% end %>
        <% if current_user.moderator? %><%= link_to "Moderation", comments_path %><% end %>
        <%= button_to "Sign out", logout_path, method: :delete, class: "link-button" %>
      <% else %>
        <%= link_to "Author sign in", login_path %>
      <% end %>
    </nav>
  </header>
  <div class="codex-rails-shell"><aside class="codex-rails-sidebar" aria-label="Application navigation"><strong>RailsProject2</strong><nav aria-label="Sections">
<%= link_to "Articles", root_path %>
<%= link_to "Search", search_path %>
<%= link_to "Categories", categories_path %>
<%= link_to "Tags", tags_path %>
<% if signed_in? %>
<%= link_to "My Articles", posts_path(mine: 1) %>
<%= link_to "New Draft", new_post_path %>
<% if current_user.editor? %>
<%= link_to "Editorial Queue", editorial_path %>
<% end %>
<% if current_user.moderator? %>
<%= link_to "Moderation", comments_path %>
<% end %>
<% else %>
<%= link_to "Author Sign In", login_path %>
<% end %>
</nav></aside><div class="codex-rails-main"><main id="main-content" tabindex="-1">
    <% flash.each do |type, message| %>
      <div class="flash <%= type %>" role="status"><%= message %></div>
    <% end %>
    <%= yield %>
  </main></div></div>
  <footer><small>&copy; <%= Time.current.year %> RailsProject2</small></footer>
</body>
</html>
