<% content_for :title, "Search — RailsProject2" %>
<h1>Search</h1>
<%= form_with url: search_path, method: :get, local: true, role: "search" do |form| %>
  <%= form.label :q, "Search published articles" %><%= form.search_field :q, value: @query, maxlength: 100 %><%= form.submit "Search" %>
<% end %>
<p aria-live="polite"><%= pluralize(@posts.size, "result") %></p>
<ul><% @posts.each do |post| %><li><%= link_to post.title, post %> — <%= post.excerpt.presence || truncate(post.body, length: 120) %></li><% end %></ul>
