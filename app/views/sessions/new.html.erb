<% content_for :title, "Author sign in — RailsProject2" %>
<h1>Author sign in</h1>
<%= form_with url: session_path, local: true do |form| %>
  <p><%= form.label :email %><%= form.email_field :email, required: true, autocomplete: "username" %></p>
  <p><%= form.label :password %><%= form.password_field :password, required: true, autocomplete: "current-password" %></p>
  <button type="button" id="fill-demo-credentials">Fill demo credentials</button>
  <%= form.submit "Sign in" %>
  <p id="demo-credentials-status" role="status" aria-live="polite"></p>
<% end %>
<script>
  document.getElementById("fill-demo-credentials").addEventListener("click", async () => {
    const status = document.getElementById("demo-credentials-status");
    status.textContent = "Loading configured credentials…";
    try {
      const response = await fetch("<%= url_for(controller: :sessions, action: :demo_credentials) %>", { cache: "no-store" });
      if (!response.ok) throw new Error("Configured demo credentials are unavailable.");
      const credentials = await response.json();
      document.getElementById("email").value = credentials.email;
      document.getElementById("password").value = credentials.password;
      status.textContent = "Demo credentials filled. Select Sign in when ready.";
    } catch (_) {
      status.textContent = "Configured demo credentials are unavailable.";
    }
  });
</script>
