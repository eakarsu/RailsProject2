RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
RAILS_MAX_THREADS=5
DATABASE_URL=postgresql://rails_project2:replace-me@database/rails_project2
DATABASE_STATEMENT_TIMEOUT=5000
SECRET_KEY_BASE=replace-with-output-from-bin-rails-secret-at-least-64-characters
FORCE_SSL=true
ACTIVE_STORAGE_SERVICE=local
# One-time, explicit provisioning only; never leave these set after db:seed.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
